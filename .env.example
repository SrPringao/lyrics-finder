# Copia este archivo como .env.local y pon el Client ID de tu app de Spotify
# (https://developer.spotify.com/dashboard). No hace falta el Client Secret: se usa PKCE.
SPOTIFY_CLIENT_ID=

# Opcional: solo si abres la app en otro puerto o dirección.
# Debe coincidir EXACTAMENTE con el Redirect URI registrado en Spotify.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
