# Contraseña para entrar a la app. Sin ella la app queda abierta (útil solo en local).
APP_PASSWORD=

# Spotify: Client ID de https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
# Debe coincidir con un Redirect URI registrado en Spotify.
SPOTIFY_REDIRECT_URI=https://letras.tudominio.com/api/spotify/callback

# Ruta del archivo SQLite (en Docker ya viene como /data/app.db).
# LYRICS_DB_PATH=/data/app.db
